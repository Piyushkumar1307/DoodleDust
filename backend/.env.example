# Copy to .env and adjust
FLASK_ENV=development
HOST=0.0.0.0
PORT=5001

# Generation (tune for your hardware)
PREVIEW_WIDTH=512
PREVIEW_HEIGHT=512
INFERENCE_STEPS=8
GUIDANCE_SCALE=5.5
CONTROLNET_CONDITIONING_SCALE=1.0

# Doodle Dust AI — fast live path (LCM, lower latency on 4060 Ti)
LIVE_WIDTH=384
LIVE_HEIGHT=384
LIVE_STEPS=4
LIVE_GUIDANCE_SCALE=1.8
LIVE_CONTROLNET_CONDITIONING_SCALE=0.9
LCM_LORA_ID=latent-consistency/lcm-lora-sdv1-5

# Hugging Face model IDs (all free, downloaded on first run)
SD_MODEL_ID=runwayml/stable-diffusion-v1-5
CONTROLNET_MODEL_ID=lllyasviel/control_v11p_sd15_scribble

# Queue
MAX_QUEUE_SIZE=8
GENERATION_TIMEOUT_SEC=120
